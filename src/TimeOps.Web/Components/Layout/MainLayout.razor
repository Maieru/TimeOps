@inherits LayoutComponentBase
@implements IDisposable
@inject DashboardNavigationState Navigation
@inject NavigationManager Router
<AuthorizeView Context="session"><Authorized>
<div class="shell">
<aside class="sidebar @(menuOpen ? "menu-open" : "")" @onkeydown="MenuKeyDown">
    <div class="sidebar-top">
        <a class="brand" href="@($"/?team={Navigation.SelectedTeamId}")"><span class="brand-mark">T</span><span>time<span class="brand-light">ops</span></span></a>
        <button class="menu-toggle" @ref="menuButton" type="button" disabled="@(!interactive)" aria-expanded="@(menuOpen ? "true" : "false")" aria-controls="workspace-navigation" @onclick="() => menuOpen = !menuOpen"><NavIcon Name="@(menuOpen ? "close" : "menu")" />Menu</button>
    </div>
    <div class="sidebar-body" id="workspace-navigation">
        <nav class="sidebar-nav" aria-label="Navegação principal">
            @foreach (var item in Links)
            {
                <a class="nav-item @(CurrentPath == item.Path ? "active" : "")" aria-current="@(CurrentPath == item.Path ? "page" : null)" href="@($"/{item.Path}?team={Navigation.SelectedTeamId}")"><NavIcon Name="@item.Icon" /><span>@item.Label</span></a>
            }
        </nav>
        <div class="sidebar-context"><span>Equipe atual</span><strong>@(Navigation.TeamName ?? "Selecione uma equipe")</strong><small>@Navigation.SprintName</small></div>
        <div class="sidebar-bottom">
            <div class="sidebar-foot"><span>GitHub Projects</span><small>Planejamento e horas no TimeOps</small></div>
            <form method="post" action="sair" data-enhance="false"><AntiforgeryToken /><button class="nav-item sign-out" type="submit"><NavIcon Name="logout" /><span>Sair · @session.User.Identity?.Name</span></button></form>
        </div>
    </div>
</aside>
<main class="main-content"><fieldset class="interaction-scope" disabled="@(!interactive)">@Body</fieldset></main>
</div>
</Authorized><NotAuthorized>@Body</NotAuthorized></AuthorizeView>
<div id="blazor-error-ui" data-nosnippet>Não foi possível manter a conexão. <a href="@($"/?team={Navigation.SelectedTeamId}")">Recarregar</a></div>
@code {
    private bool interactive, menuOpen;
    private ElementReference menuButton;
    private static readonly (string Path, string Label, string Icon)[] Links = [("", "Painel", "dashboard"), ("planejamento", "Planejamento", "planning"), ("tarefas", "Tarefas", "tasks"), ("horas", "Apontamentos", "hours"), ("acessos", "Acessos", "access")];
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { interactive = true; StateHasChanged(); } }
    private string CurrentPath => Router.ToBaseRelativePath(Router.Uri).Split('?', '#')[0].Trim('/');
    protected override void OnInitialized() { Navigation.Changed += Refresh; Router.LocationChanged += LocationChanged; }
    private void LocationChanged(object? sender, LocationChangedEventArgs e) { menuOpen = false; Refresh(); }
    private async Task MenuKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape" && menuOpen) { menuOpen = false; await menuButton.FocusAsync(); } }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Navigation.Changed -= Refresh; Router.LocationChanged -= LocationChanged; }
}
