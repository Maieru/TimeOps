<section class="planning-section"><h2>Tarefas e implementações</h2><p>Horas realizadas por tarefa central, somando as implementações de cada produto.</p>
@if(Error is not null){<div class="notice error" role="alert">@Error</div>}
@foreach(var feature in Features){<details class="task-hierarchy editor"><summary>@(feature.Feature?.Title??"Sem tarefa central") <span>@feature.Completed?.ToString("N2") h</span></summary><TaskList Tasks="@feature.Stories.SelectMany(s=>s.Tasks).ToArray()" /></details>}
@if(Features.Count==0){<p class="muted">Nenhuma implementação planejada nesta sprint.</p>}
</section>
@code{[Parameter] public IReadOnlyList<FeatureEffort> Features{get;set;}=[];[Parameter] public int TaskCount{get;set;}[Parameter] public string? Error{get;set;}}
