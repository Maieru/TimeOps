@using System.Globalization
@using TimeOps.Domain

<section class="hierarchy-panel" aria-label="Horas por feature e história">
    <div class="hierarchy-heading">
        <div>
            <h2>Horas por feature</h2>
            <p>Totais de <strong>Completed Work</strong> das Tasks desta sprint e equipe. Abra cada linha para ver a composição das horas.</p>
        </div>
        <span class="hierarchy-count">@TaskCount @(TaskCount == 1 ? "Task" : "Tasks")</span>
    </div>

    @if (Error is not null)
    {
        <div class="hierarchy-empty" role="status">@Error</div>
    }
    else if (TaskCount == 0)
    {
        <div class="hierarchy-empty">Nenhuma Task encontrada nesta sprint. Selecione outra sprint ou atualize os dados.</div>
    }
    else
    {
        <div class="hierarchy-list">
            @foreach (var feature in Features)
            {
                var featureTaskCount = feature.Stories.Sum(story => story.Tasks.Count);
                <details class="hierarchy-feature">
                    <summary>
                        <span class="hierarchy-chevron" aria-hidden="true"></span>
                        <span class="hierarchy-type-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7 4h10v5a5 5 0 0 1-10 0V4Z"/><path d="M7 6H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4m-4 2v3m-4 3h8m-8 0v-3h8v3"/></svg></span>
                        <span class="hierarchy-identity"><span class="hierarchy-meta"><span class="hierarchy-kind">@(feature.Feature is null ? "Sem vínculo" : "Feature")</span><small>@featureTaskCount @(featureTaskCount == 1 ? "Task" : "Tasks")</small>@if (feature.Feature is not null) { <a class="hierarchy-row-link" href="@feature.Feature.Url" target="_blank" rel="noopener noreferrer" aria-label="Abrir feature #@feature.Feature.Id no Azure DevOps" @onclick:stopPropagation>Abrir #@feature.Feature.Id no DevOps <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M9 3h4v4m0-4L7 9m5 0v4H3V4h4"/></svg></a> }</span><strong>@(feature.Feature?.Title ?? "Sem feature")</strong></span>
                        <span class="hierarchy-hours">@Hours(feature.Completed)</span>
                    </summary>
                    <div class="hierarchy-children">
                        @foreach (var story in feature.Stories)
                        {
                            <details class="hierarchy-story">
                                <summary>
                                    <span class="hierarchy-chevron" aria-hidden="true"></span>
                                    <span class="hierarchy-type-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 6.5C9.6 5 6.9 4.7 4 5v13.5c2.9-.3 5.6 0 8 1.5m0-12.5c2.4-1.5 5.1-1.8 8-1.5v13.5c-2.9-.3-5.6 0-8 1.5m0-12.5V19"/></svg></span>
                                    <span class="hierarchy-identity"><span class="hierarchy-meta"><span class="hierarchy-kind">@(story.Story?.Type ?? "Sem vínculo")</span><small>@story.Tasks.Count @(story.Tasks.Count == 1 ? "Task" : "Tasks")</small>@if (story.Story is not null) { <a class="hierarchy-row-link" href="@story.Story.Url" target="_blank" rel="noopener noreferrer" aria-label="Abrir história #@story.Story.Id no Azure DevOps" @onclick:stopPropagation>Abrir #@story.Story.Id no DevOps <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M9 3h4v4m0-4L7 9m5 0v4H3V4h4"/></svg></a> }</span><strong>@(story.Story?.Title ?? "Tasks sem história")</strong></span>
                                    <span class="hierarchy-hours">@Hours(story.Completed)</span>
                                </summary>
                                <div class="hierarchy-children">
                                    @foreach (var task in story.Tasks)
                                    {
                                        <details class="hierarchy-task">
                                            <summary>
                                                <span class="hierarchy-chevron" aria-hidden="true"></span>
                                                <span class="hierarchy-type-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M9 5H5v16h14V5h-4M9 3h6v4H9V3Zm0 10h6m-6 4h6"/></svg></span>
                                                <span class="hierarchy-identity"><span class="hierarchy-meta"><span class="hierarchy-kind">Task #@task.Id</span><a class="hierarchy-row-link" href="@task.Url" target="_blank" rel="noopener noreferrer" aria-label="Abrir Task #@task.Id no Azure DevOps" @onclick:stopPropagation>Abrir no DevOps <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M9 3h4v4m0-4L7 9m5 0v4H3V4h4"/></svg></a></span><strong>@task.Title</strong></span>
                                                <span class="hierarchy-hours">@Hours(story.Completed is null ? null : task.Completed ?? 0)</span>
                                            </summary>
                                            <div class="hierarchy-task-info">
                                                <span>@task.State · @(task.Assignee?.Name ?? "Sem responsável")</span>
                                                @if (task.Completed is null && story.Completed is not null)
                                                {
                                                    <span>Completed vazio: 0 h na soma</span>
                                                }
                                            </div>
                                        </details>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                </details>
            }
        </div>
        <p class="hierarchy-note">Tasks sem vínculo de hierarquia aparecem em “Sem feature” ou “Tasks sem história”. Campos Completed vazios entram como zero e são sinalizados nos avisos sobre os dados.</p>
    }
</section>

@code {
    private static readonly CultureInfo Pt = CultureInfo.GetCultureInfo("pt-BR");
    [Parameter, EditorRequired] public IReadOnlyList<FeatureEffort> Features { get; set; } = [];
    [Parameter, EditorRequired] public int TaskCount { get; set; }
    [Parameter] public string? Error { get; set; }
    private static string Hours(decimal? value) => value is null ? "—" : $"{value.Value.ToString("N2", Pt)} h";
}
