@inject PlanningReports Reports
@inject TimeProvider Clock
<section class="planning-section"><h2>Exportar apontamentos</h2><p>Uma linha por apontamento ativo, com pessoa, data trabalhada, implementação, tarefa central e horas.</p>
<form @onsubmit="Load" @onsubmit:preventDefault class="form-grid editor"><div class="field"><label for="export-from">Data inicial</label><input id="export-from" type="date" @bind="from" required /></div><div class="field"><label for="export-to">Data final</label><input id="export-to" type="date" @bind="to" required /></div><button class="refresh" disabled="@loading">Carregar prévia</button></form>
@if(error is not null){<div class="notice error" role="alert">@error</div>}
@if(data is not null){<div class="field context-picker"><label for="export-person">Pessoa</label><select id="export-person" @bind="author"><option value="">Todos os autores</option>@foreach(var person in data.Rows.Select(r=>r.Author!).DistinctBy(p=>p.Id)){<option value="@person.Id">@person.Name</option>}</select></div><div class="section-header"><p>@Rows.Count registros · @Rows.Sum(r=>r.Hours).ToString("N2") h</p>@if(Rows.Count>0){<a class="primary-action" href="@DownloadUrl" data-enhance-nav="false">Baixar Excel</a>}</div><div class="table-scroll compact-table"><table><thead><tr><th>Pessoa / data</th><th>Atividade</th><th>Tarefa central</th><th>Horas</th></tr></thead><tbody>@foreach(var row in Rows.Take(50)){<tr><th>@row.AuthorName<small>@row.Date.ToString("dd/MM/yyyy")</small></th><td>@row.TaskTitle</td><td>@row.FeatureTitle</td><td>@row.Hours.ToString("N2")</td></tr>}</tbody></table></div><p class="muted">A prévia mostra até 50 registros. O arquivo inclui todos os apontamentos selecionados e mantém as sete colunas do modelo.</p>}
</section>
@code{
[Parameter]public string ProjectId{get;set;}="";[Parameter]public string TeamId{get;set;}="";[Parameter,EditorRequired]public Sprint Sprint{get;set;}=null!;[Parameter]public string TimeZoneId{get;set;}="America/Sao_Paulo";
private DateOnly from,to;private string author="";private bool loading;private string? error;private TaskExportData? data;
private IReadOnlyList<TaskExportRow> Rows=>data?.ForAuthor(author.Length==0?null:author)??[];
private string DownloadUrl=>$"exportar?teamId={TeamId}&sprintId={Sprint.Id}&from={data!.From:yyyy-MM-dd}&to={data.To:yyyy-MM-dd}&author={Uri.EscapeDataString(author)}";
protected override void OnInitialized(){var today=DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(),TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId)).DateTime);from=Sprint.Start??today;to=Sprint.End is {} end&&end<today?end:today;}
private async Task Load(){loading=true;error=null;data=null;try{var result=await Reports.ExportAsync(int.Parse(TeamId),int.Parse(Sprint.Id),from,to);if(result.IsFailure)error=result.Error!.Message;else data=result.Value;}finally{loading=false;}}
}
