@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using TimeOps.Application
@using TimeOps.Domain
@inject DashboardService Service
@inject ILogger<Home> Logger

<PageTitle>Visão da sprint · TimeOps</PageTitle>

<header class="page-header">
    <div>
        <h1>Visão da sprint</h1>
        <p>Capacidade e horas registradas, diretamente do Azure DevOps.</p>
    </div>
    @if (Service.HasConnection)
    {
        <div class="header-actions">
            @if (dashboard is not null)
            {
                <div class="collected"><span class="collected-dot"></span> Coletado em @Service.LocalTime(dashboard.CollectedAt).ToString("dd/MM/yyyy 'às' HH:mm", Pt)</div>
            }
            <button class="connection-change" type="button" @onclick="ChangeConnection" disabled="@busy">Trocar conexão</button>
        </div>
    }
</header>

@if (!Service.HasConnection)
{
    <form class="connection-panel" @onsubmit="ConnectAsync" @onsubmit:preventDefault autocomplete="off">
        <div class="connection-copy">
            <h2>Conectar ao Azure DevOps</h2>
            <p>Informe a organização e um PAT com permissões de leitura. Os dados ficam somente nesta sessão local.</p>
        </div>
        <div class="field">
            <label for="organization">Organização</label>
            <input id="organization" type="text" @bind="organizationInput" @bind:event="oninput" placeholder="minha-organizacao" autocomplete="off" required />
        </div>
        <div class="field">
            <label for="pat">Personal Access Token</label>
            <input id="pat" type="password" @bind="patInput" @bind:event="oninput" autocomplete="off" required />
        </div>
        <button class="connect-button" type="submit" disabled="@busy">Conectar</button>
    </form>
}
else
{
<section class="filters" aria-label="Selecionar contexto">
    <div class="field">
        <label for="project">Projeto</label>
        <select id="project" value="@projectId" @onchange="OnProjectChanged" disabled="@busy">
            <option value="">Selecione o projeto</option>
            @foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }
        </select>
    </div>
    <div class="field">
        <label for="team">Equipe</label>
        <select id="team" value="@teamId" @onchange="OnTeamChanged" disabled="@(busy || string.IsNullOrEmpty(projectId))">
            <option value="">Selecione a equipe</option>
            @foreach (var team in teams) { <option value="@team.Id">@team.Name</option> }
        </select>
    </div>
    <div class="field">
        <label for="sprint">Sprint</label>
        <select id="sprint" value="@sprintId" @onchange="OnSprintChanged" disabled="@(busy || string.IsNullOrEmpty(teamId))">
            <option value="">Selecione a sprint</option>
            @foreach (var sprint in sprints) { <option value="@sprint.Id">@sprint.Name</option> }
        </select>
    </div>
    <div class="field date-field">
        <label for="reference">Capacidade até</label>
        <input id="reference" type="date" value="@referenceText" max="@Service.Today.ToString("yyyy-MM-dd")" @onchange="OnReferenceChanged" disabled="@(busy || string.IsNullOrEmpty(sprintId))" />
    </div>
    <button class="refresh" type="button" @onclick="Refresh" disabled="@(busy || string.IsNullOrEmpty(sprintId))">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 6M20 4v7h-7"/></svg>
        Atualizar
    </button>
</section>
}

@if (busy)
{
    <div class="notice loading" role="status">Consultando o Azure DevOps…</div>
}
@if (error is not null)
{
    <div class="notice error" role="alert"><strong>@errorTitle</strong> @error</div>
}
@if (stale && dashboard is not null)
{
    <div class="notice warning" role="status">Os números abaixo são da última coleta completa, indicada no cabeçalho. Tente atualizar novamente.</div>
}

@if (dashboard is null)
{
    <section class="empty-state">
        <div class="empty-symbol"><span></span><span></span><span></span></div>
        <h2>Seu acompanhamento começa aqui</h2>
        <p>@(Service.HasConnection ? "Escolha um projeto, uma equipe e uma sprint para comparar a capacidade esperada com as horas em Completed." : "Conecte-se para consultar projetos, equipes e sprints disponíveis.")</p>
    </section>
}
else
{
    <div class="context-line">
        <span>@dashboard.Sprint.Name</span>
        @if (dashboard.Sprint.Start is not null && dashboard.Sprint.End is not null)
        {
            <span class="divider">/</span><span>@dashboard.Sprint.Start.Value.ToString("dd/MM") — @dashboard.Sprint.End.Value.ToString("dd/MM/yyyy")</span>
        }
        <span class="divider">/</span><span>Capacidade até @dashboard.ReferenceDate.ToString("dd/MM/yyyy")</span>
    </div>

    <section class="summary" aria-label="Resumo da equipe">
        <div class="summary-primary"><p>Horas registradas <MetricInfo Title="Horas registradas" Description="@MetricHelp.Completed" /></p><strong>@Hours(dashboard.Team.Completed)</strong><span>Completed nas Tasks desta sprint</span></div>
        <div class="summary-item"><p>Esperadas até a referência <MetricInfo Title="Horas esperadas" Description="@MetricHelp.Expected" /></p><strong>@Hours(dashboard.Team.Expected)</strong><span>@(dashboard.Team.Expected is null ? "Capacidade incompleta" : "Capacidade dos dias decorridos")</span></div>
        <div class="summary-item"><p>Diferença <MetricInfo Title="Diferença" Description="@MetricHelp.Difference" /></p><strong class="@VarianceClass(dashboard.Team.Difference)">@SignedHours(dashboard.Team.Difference)</strong><span>@CoverageCaption(dashboard.Team) <MetricInfo Title="Cobertura" Description="@MetricHelp.Coverage" /></span></div>
        <div class="summary-item"><p>Trabalho restante <MetricInfo Title="Trabalho restante" Description="@MetricHelp.Remaining" /></p><strong>@Hours(dashboard.Team.Remaining)</strong><span>@(dashboard.Team.FutureCapacity is null ? "Capacidade futura indisponível" : $"{Hours(dashboard.Team.FutureCapacity)} de capacidade futura") <MetricInfo Title="Capacidade futura" Description="@MetricHelp.FutureCapacity" /></span></div>
    </section>

    @if (dashboard.Warnings.Count > 0)
    {
        <details class="data-quality">
            <summary>
                <span class="data-quality-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5h.01"/></svg></span>
                <span class="data-quality-copy"><strong>@WarningCountLabel(dashboard.Warnings.Count)</strong><span>@(dashboard.Team.Expected is null ? "A capacidade da equipe está incompleta. Confira o que falta." : "Confira campos e Tasks que precisam de atenção.")</span></span>
                <span class="data-quality-expand"><span class="when-closed">Ver avisos</span><span class="when-open">Recolher</span></span>
            </summary>
            <div class="warning-groups">
                @foreach (var group in dashboard.Warnings.GroupBy(warning => warning.Code))
                {
                    <section class="warning-group">
                        <h3>@WarningLabel(group.Key) <span>@group.Count()</span></h3>
                        <ul>@foreach (var warning in group) { <li>@warning.Message</li> }</ul>
                    </section>
                }
            </div>
        </details>
    }

    <section class="data-section">
        <div class="section-header"><div><h2>Pessoas da equipe</h2><p>Abra uma pessoa para conferir as Tasks que compõem os totais.</p><p class="table-hint">Role a tabela na horizontal para ver todas as métricas.</p></div><span class="section-count">@PeopleCountLabel(dashboard.People.Count) <MetricInfo Title="Pessoas da equipe" Description="@MetricHelp.PeopleCount" /></span></div>
        <details class="mobile-metric-guide">
            <summary>Como ler as métricas</summary>
            <div>
                <span>Completed <MetricInfo Title="Completed por pessoa" Description="@MetricHelp.PersonCompleted" /></span>
                <span>Esperado <MetricInfo Title="Esperado por pessoa" Description="@MetricHelp.PersonExpected" /></span>
                <span>Diferença <MetricInfo Title="Diferença por pessoa" Description="@MetricHelp.Difference" /></span>
                <span>Cobertura <MetricInfo Title="Cobertura por pessoa" Description="@MetricHelp.Coverage" /></span>
                <span>Estimativa <MetricInfo Title="Estimativa original por pessoa" Description="@MetricHelp.PersonOriginal" /></span>
                <span>Restante <MetricInfo Title="Trabalho restante por pessoa" Description="@MetricHelp.PersonRemaining" /></span>
                <span>Cap. total <MetricInfo Title="Capacidade total" Description="@MetricHelp.TotalCapacity" /></span>
                <span>Cap. futura <MetricInfo Title="Capacidade futura" Description="@MetricHelp.FutureCapacity" /></span>
                <span>Saldo futuro <MetricInfo Title="Saldo futuro" Description="@MetricHelp.FutureBalance" /></span>
            </div>
        </details>
        <div class="table-scroll">
            <table>
                <thead><tr>
                    <th>Pessoa <MetricInfo Title="Pessoa e Tasks" Description="@MetricHelp.PersonTasks" /></th>
                    <th>Completed <MetricInfo Title="Completed por pessoa" Description="@MetricHelp.PersonCompleted" /></th>
                    <th>Esperado <MetricInfo Title="Esperado por pessoa" Description="@MetricHelp.PersonExpected" /></th>
                    <th>Diferença <MetricInfo Title="Diferença por pessoa" Description="@MetricHelp.Difference" /></th>
                    <th>Cobertura <MetricInfo Title="Cobertura por pessoa" Description="@MetricHelp.Coverage" /></th>
                    <th>Estimativa <MetricInfo Title="Estimativa original por pessoa" Description="@MetricHelp.PersonOriginal" /></th>
                    <th>Restante <MetricInfo Title="Trabalho restante por pessoa" Description="@MetricHelp.PersonRemaining" /></th>
                    <th>Cap. total <MetricInfo Title="Capacidade total" Description="@MetricHelp.TotalCapacity" /></th>
                    <th>Cap. futura <MetricInfo Title="Capacidade futura" Description="@MetricHelp.FutureCapacity" /></th>
                    <th>Saldo futuro <MetricInfo Title="Saldo futuro" Description="@MetricHelp.FutureBalance" /></th>
                </tr></thead>
                <tbody>
                    @foreach (var person in dashboard.People)
                    {
                        <tr>
                            <th scope="row"><details><summary>@person.Person!.Name <small>@TaskCountLabel(person.Tasks.Count)</small></summary><TaskList Tasks="person.Tasks" /></details></th>
                            <td data-label="Completed">@Hours(person.Completed)</td><td data-label="Esperado">@Hours(person.Expected)</td><td data-label="Diferença" class="@VarianceClass(person.Difference)">@SignedHours(person.Difference)</td><td data-label="Cobertura">@Percent(person.Coverage)</td><td data-label="Estimativa">@Hours(person.Original)</td><td data-label="Restante">@Hours(person.Remaining)</td><td data-label="Cap. total">@Hours(person.TotalCapacity)</td><td data-label="Cap. futura">@Hours(person.FutureCapacity)</td><td data-label="Saldo futuro" class="@VarianceClass(person.FutureBalance)">@SignedHours(person.FutureBalance)</td>
                        </tr>
                    }
                    @if (dashboard.Unassigned is not null)
                    {
                        <tr class="unassigned"><th scope="row"><details><summary>Sem responsável <small>@TaskCountLabel(dashboard.Unassigned.Tasks.Count)</small></summary><TaskList Tasks="dashboard.Unassigned.Tasks" /></details></th><td data-label="Completed">@Hours(dashboard.Unassigned.Completed)</td><td data-label="Esperado">—</td><td data-label="Diferença">—</td><td data-label="Cobertura">—</td><td data-label="Estimativa">@Hours(dashboard.Unassigned.Original)</td><td data-label="Restante">@Hours(dashboard.Unassigned.Remaining)</td><td data-label="Cap. total">—</td><td data-label="Cap. futura">—</td><td data-label="Saldo futuro">—</td></tr>
                    }
                    @if (dashboard.People.Count == 0 && dashboard.Unassigned is null)
                    {
                        <tr><td colspan="10" class="no-data">Nenhuma pessoa com capacidade ou Task nesta sprint.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="secondary-stats" aria-label="Outras métricas">
        <div><span>Capacidade total <MetricInfo Title="Capacidade total" Description="@MetricHelp.TotalCapacity" /></span><strong>@Hours(dashboard.Team.TotalCapacity)</strong></div>
        <div><span>Saldo futuro <MetricInfo Title="Saldo futuro" Description="@MetricHelp.FutureBalance" /></span><strong class="@VarianceClass(dashboard.Team.FutureBalance)">@SignedHours(dashboard.Team.FutureBalance)</strong></div>
        <div><span>Estimativa original <MetricInfo Title="Estimativa original" Description="@MetricHelp.Original" /></span><strong>@Hours(dashboard.Team.Original)</strong></div>
        <div><span>Tasks concluídas <MetricInfo Title="Tasks concluídas" Description="@MetricHelp.CompletedTasks" /></span><strong>@dashboard.Team.CompletedTaskCount / @dashboard.Team.TaskCount</strong><small>@Percent(dashboard.Team.TaskProgress)</small></div>
    </section>

    <section class="state-counts" aria-label="Tasks por categoria de estado">
        <span>Tasks por estado <MetricInfo Title="Tasks por estado" Description="@MetricHelp.StateCounts" /></span>
        @foreach (var category in dashboard.Team.StateCategories.OrderBy(item => item.Key))
        {
            <span class="state-count">@CategoryLabel(category.Key) <strong>@category.Value</strong></span>
        }
        @if (dashboard.Team.StateCategories.Count == 0) { <span>Sem Tasks nesta sprint</span> }
    </section>

    <p class="method-note">Completed mostra o valor atual das Tasks atribuídas agora. A data escolhida altera a capacidade esperada, mas não reconstrói horas passadas. Estes dados não representam uma avaliação automática de produtividade.</p>
}

@code {
    private static readonly CultureInfo Pt = CultureInfo.GetCultureInfo("pt-BR");
    private static class MetricHelp
    {
        public const string Completed = "Soma do Completed Work das Tasks desta sprint e do escopo da equipe, inclusive concluídas e sem responsável. É o valor atual no DevOps, mesmo se a data de referência for anterior. Campos vazios entram como zero e geram aviso.";
        public const string PersonCompleted = "Soma do Completed Work das Tasks atualmente atribuídas a esta pessoa. Campos vazios entram como zero e geram aviso.";
        public const string PeopleCount = "Quantidade de pessoas com capacidade cadastrada ou com Tasks atribuídas nesta sprint. Tasks sem responsável aparecem em uma linha separada e não aumentam esta contagem.";
        public const string PersonTasks = "Cada linha reúne a capacidade cadastrada da pessoa e as Tasks atualmente atribuídas a ela no escopo da sprint e da equipe. A contagem ao lado do nome mostra quantas Tasks compõem seus totais; abra a linha para ver os itens.";
        public const string Expected = "Soma da capacidade diária cadastrada nas atividades de cada pessoa multiplicada pelos dias de trabalho da sprint até a data de referência, descontadas folgas individuais e da equipe. Um travessão indica capacidade ausente ou Tasks sem responsável, impedindo um total completo.";
        public const string PersonExpected = "Capacidade diária desta pessoa multiplicada pelos dias de trabalho da sprint até a data de referência, descontadas as folgas. Um travessão indica que sua capacidade não está cadastrada.";
        public const string Difference = "Horas registradas menos horas esperadas. Valor negativo indica menos horas registradas que a capacidade acumulada; positivo indica mais. Um travessão significa que algum dado necessário está indisponível.";
        public const string Coverage = "Horas registradas divididas pelas horas esperadas, em porcentagem. Não se aplica quando a expectativa é zero ou está indisponível.";
        public const string Remaining = "Soma do Remaining Work atual das Tasks desta sprint e do escopo da equipe, inclusive sem responsável e concluídas que ainda tenham valor restante. Não é a diferença entre horas esperadas e registradas. Campos vazios entram como zero e geram aviso.";
        public const string PersonRemaining = "Soma do Remaining Work atual das Tasks atribuídas a esta pessoa. Campos vazios entram como zero e geram aviso.";
        public const string TotalCapacity = "Capacidade diária multiplicada por todos os dias de trabalho da sprint, descontadas as folgas. O total da equipe fica indisponível se faltar capacidade de alguém ou houver Tasks sem responsável.";
        public const string FutureCapacity = "Capacidade dos dias de trabalho após a data de referência até o fim da sprint, descontadas as folgas. No total da equipe, um travessão indica capacidade ausente ou Tasks sem responsável.";
        public const string FutureBalance = "Capacidade futura menos Remaining Work. Valor negativo indica mais trabalho restante que capacidade futura. Um travessão indica capacidade futura ou Remaining Work indisponível.";
        public const string Original = "Soma do Original Estimate das Tasks desta sprint e do escopo da equipe. É uma estimativa inicial, separada das horas registradas e restantes; campos vazios entram como zero e geram aviso.";
        public const string PersonOriginal = "Soma do Original Estimate das Tasks atualmente atribuídas a esta pessoa. Campos vazios entram como zero e geram aviso.";
        public const string CompletedTasks = "Quantidade de Tasks na categoria de estado Concluídas sobre todas as Tasks da sprint no escopo da equipe. A porcentagem é calculada por quantidade, não por horas.";
        public const string StateCounts = "Quantidade atual de Tasks em cada categoria de estado do Azure DevOps. Cada Task é contada uma vez.";
    }
    private IReadOnlyList<NamedItem> projects = [];
    private IReadOnlyList<NamedItem> teams = [];
    private IReadOnlyList<Sprint> sprints = [];
    private string projectId = "";
    private string teamId = "";
    private string sprintId = "";
    private string referenceText = "";
    private string organizationInput = "";
    private string patInput = "";
    private Dashboard? dashboard;
    private string? error;
    private string errorTitle = "Não foi possível atualizar.";
    private bool busy;
    private bool stale;

    protected override async Task OnInitializedAsync()
    {
        referenceText = Service.Today.AddDays(-1).ToString("yyyy-MM-dd");
        organizationInput = Service.Organization;
        if (!Service.HasConnection) return;
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        busy = true;
        try
        {
            var result = await Service.ListProjectsAsync();
            if (result.IsFailure) error = result.Error!.Message;
            else projects = result.Value;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Falha inesperada ao listar projetos");
            error = "Ocorreu um erro inesperado. Recarregue a página.";
        }
        finally { busy = false; }
    }

    private async Task ConnectAsync()
    {
        var result = Service.ConfigureConnection(organizationInput, patInput);
        patInput = "";
        error = null;
        errorTitle = "Não foi possível conectar.";
        if (result.IsFailure) { error = result.Error!.Message; return; }
        await LoadProjects();
    }

    private void ChangeConnection()
    {
        organizationInput = Service.Organization;
        Service.Disconnect();
        patInput = "";
        projects = [];
        teams = [];
        sprints = [];
        projectId = teamId = sprintId = "";
        dashboard = null;
        error = null;
        stale = false;
    }

    private async Task OnProjectChanged(ChangeEventArgs args)
    {
        projectId = args.Value?.ToString() ?? "";
        teamId = sprintId = "";
        teams = [];
        sprints = [];
        dashboard = null;
        stale = false;
        error = null;
        if (projectId.Length == 0) return;
        busy = true;
        try
        {
            var result = await Service.ListTeamsAsync(projectId);
            if (result.IsFailure) error = result.Error!.Message;
            else teams = result.Value;
        }
        catch (Exception) { error = "Não foi possível carregar as equipes. Tente novamente."; }
        finally { busy = false; }
    }

    private async Task OnTeamChanged(ChangeEventArgs args)
    {
        teamId = args.Value?.ToString() ?? "";
        sprintId = "";
        sprints = [];
        dashboard = null;
        stale = false;
        error = null;
        if (teamId.Length == 0) return;
        busy = true;
        try
        {
            var result = await Service.ListSprintsAsync(projectId, teamId);
            if (result.IsFailure) error = result.Error!.Message;
            else
            {
                sprints = result.Value;
                var today = Service.Today;
                var current = sprints.Where(sprint => sprint.Start <= today && sprint.End >= today).ToArray();
                if (current.Length == 1) { sprintId = current[0].Id; await Load(false); }
            }
        }
        catch (Exception) { error = "Não foi possível carregar as sprints. Tente novamente."; }
        finally { busy = false; }
    }

    private async Task OnSprintChanged(ChangeEventArgs args)
    {
        sprintId = args.Value?.ToString() ?? "";
        dashboard = null;
        stale = false;
        error = null;
        if (sprintId.Length > 0) await Load(false);
    }

    private async Task OnReferenceChanged(ChangeEventArgs args)
    {
        referenceText = args.Value?.ToString() ?? "";
        if (sprintId.Length > 0) await Load(false);
    }

    private Task Refresh() => Load(true);

    private async Task Load(bool force)
    {
        var sprint = sprints.FirstOrDefault(item => item.Id == sprintId);
        if (sprint is null) return;
        if (!DateOnly.TryParseExact(referenceText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var reference))
        { error = "Informe uma data de referência válida."; stale = dashboard is not null; return; }
        busy = true;
        error = null;
        try
        {
            var result = await Service.GetDashboardAsync(projectId, teamId, sprint, reference, force);
            if (result.IsFailure) { error = result.Error!.Message; stale = dashboard is not null; }
            else { dashboard = result.Value; stale = false; }
        }
        catch (Exception) { error = "Ocorreu um erro inesperado. Tente atualizar novamente."; stale = dashboard is not null; }
        finally { busy = false; }
    }

    private static string Hours(decimal? value) => value is null ? "—" : $"{value.Value.ToString("N2", Pt)} h";
    private static string SignedHours(decimal? value) => value is null ? "—" : $"{(value > 0 ? "+" : "")}{value.Value.ToString("N2", Pt)} h";
    private static string Percent(decimal? value) => value is null ? "N/A" : $"{value.Value.ToString("N2", Pt)}%";
    private static string WarningCountLabel(int count) => $"{count} {(count == 1 ? "aviso" : "avisos")} sobre os dados";
    private static string PeopleCountLabel(int count) => $"{count} {(count == 1 ? "pessoa" : "pessoas")}";
    private static string TaskCountLabel(int count) => $"{count} {(count == 1 ? "Task" : "Tasks")}";
    private static string CoverageCaption(TeamMetrics team) => team.Coverage is not null
        ? $"{team.Coverage.Value.ToString("N2", Pt)}% de cobertura"
        : team.Expected == 0 && team.Completed is not null ? "Cobertura não aplicável" : "Cobertura indisponível";
    private static string VarianceClass(decimal? value) => value is null ? "" : value < 0 ? "negative" : value > 0 ? "positive" : "";
    private static string WarningLabel(string code) => code switch
    {
        "capacity.missing" => "Capacidade ausente",
        "completed.empty" => "Completed vazio",
        "original.empty" => "Estimativa original vazia",
        "remaining.empty" => "Trabalho restante vazio",
        "completed.remaining" => "Tasks concluídas com trabalho restante",
        "field.completed.missing" => "Completed indisponível",
        "field.original.missing" => "Estimativa original indisponível",
        "field.remaining.missing" => "Trabalho restante indisponível",
        _ => "Outros avisos"
    };
    private static string CategoryLabel(string category) => category switch
    {
        "Proposed" => "Propostas", "InProgress" => "Em andamento", "Resolved" => "Resolvidas",
        "Completed" => "Concluídas", "Removed" => "Removidas", _ => category
    };
}
