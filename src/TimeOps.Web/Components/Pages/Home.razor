@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inherits WorkspacePage
@implements IDisposable
@inject PlanningReports Reports
@inject TimeProvider Clock
<PageTitle>@ViewTitle · TimeOps</PageTitle>
<header class="page-header"><div><h1>@ViewTitle</h1><p>Capacidade planejada, horas trabalhadas e execução por produto.</p></div><a class="primary-action" href="@($"tarefas?team={TeamId}&tab=new")">Criar tarefa</a></header>
<Feedback Busy="Busy" Error="@Error" Message="@Message" />
<SectionTabs Id="dashboard" Label="Visões do painel" Items="ReportTabs" Value="@Navigation.Current.ToString()" ValueChanged="SelectReport" Context="report">
@if(Workspace is not null)
{
<details class="dashboard-context" open="@(dashboard is null)">
<summary><span><strong>@(Data.Teams.SingleOrDefault(t => t.Id == TeamId)?.Name ?? "Selecione uma equipe")</strong><small>@(dashboard?.Sprint.Name ?? "Selecione uma sprint")@(productId != 0 ? " · " + Data.Products.Single(p => p.Id == productId).Name : "")</small></span><span class="context-edit">Ajustar filtros</span></summary>
<section class="filters" aria-label="Contexto do painel">
<div class="field"><label for="dashboard-team">Equipe</label><select id="dashboard-team" value="@TeamId" @onchange="ChangeTeam"><option value="0">Selecione</option>@foreach(var t in Workspace.Teams){<option value="@t.Id">@t.Name</option>}</select></div>
<div class="field"><label for="dashboard-cycle">Ciclo</label><select id="dashboard-cycle" @bind="cycleId" @bind:after="CycleChanged"><option value="0">Todos os ciclos</option>@foreach(var c in Data.Cycles.Where(c=>c.TeamId==TeamId)){<option value="@c.Id">@c.Name</option>}</select></div>
<div class="field"><label for="dashboard-sprint">Sprint</label><select id="dashboard-sprint" @bind="sprintId" @bind:after="LoadDashboard"><option value="0">Selecione</option>@foreach(var s in Sprints){<option value="@s.Id">@s.Name</option>}</select></div>
<div class="field"><label for="dashboard-reference">Referência da capacidade</label><input id="dashboard-reference" type="date" @bind="reference" @bind:after="LoadDashboard" max="@Today.ToString("yyyy-MM-dd")" /></div><button class="refresh" @onclick="Refresh" disabled="@Busy">Atualizar dados</button>
</section>
@if(sprintId!=0 && Navigation.Current is not (DashboardView.Burndown or DashboardView.Export))
{
<div class="field context-picker"><label for="dashboard-product">Produto</label><select id="dashboard-product" @bind="productId" @bind:after="LoadDashboard"><option value="0">Todos os produtos</option>@foreach(var p in Data.Products.Where(p=>p.TeamId==TeamId)){<option value="@p.Id">@p.Name</option>}</select></div>
}
</details>
@if(dashboard is null)
{
<div class="empty-state"><h2>Planeje a primeira sprint</h2><p>Selecione uma equipe e uma sprint. O planejamento reúne ciclos, integrantes, funções, capacidades e produtos.</p><a href="@($"planejamento?team={TeamId}")">Abrir planejamento</a></div>
}
else
{
<p class="sprint-period">@dashboard.Sprint.Start?.ToString("dd/MM/yyyy") a @dashboard.Sprint.End?.ToString("dd/MM/yyyy") · Referência: @reference.ToString("dd/MM/yyyy")</p>
@if(dashboard.Warnings.Count>0){<details class="notice warning"><summary>@dashboard.Warnings.Count avisos sobre os dados</summary><ul>@foreach(var warning in dashboard.Warnings){<li>@warning.Message</li>}</ul></details>}
@if(Navigation.Current==DashboardView.Team)
{
<section class="summary" aria-label="Resumo da sprint"><div class="summary-primary"><p>Horas realizadas</p><strong>@H(dashboard.Team.Completed)</strong><span>Apontamentos desta sprint</span></div><div><p>Capacidade esperada</p><strong>@H(dashboard.Team.Expected)</strong><span>Até @reference.ToString("dd/MM/yyyy")</span></div><div><p>Trabalho restante</p><strong>@H(dashboard.Team.Remaining)</strong><span>Estimado no TimeOps</span></div><div><p>Capacidade futura</p><strong>@H(dashboard.Team.FutureCapacity)</strong><span>Após a referência</span></div></section>
<section class="planning-section"><h2>Pessoas da equipe</h2><div class="table-scroll"><table><thead><tr><th>Pessoa</th><th>Realizado</th><th>Esperado</th><th>Diferença</th><th>Cobertura</th><th>Estimativa</th><th>Restante</th><th>Capacidade total</th><th>Saldo futuro</th></tr></thead><tbody>@foreach(var p in dashboard.People){<tr><th><details><summary>@p.Person!.Name</summary><TaskList Tasks="p.Tasks" /></details></th><td data-label="Realizado">@H(p.Completed)</td><td data-label="Esperado">@H(p.Expected)</td><td data-label="Diferença">@H(p.Difference)</td><td data-label="Cobertura">@(p.Coverage?.ToString("N1")+ (p.Coverage is null?"—":"%"))</td><td data-label="Estimativa">@H(p.Original)</td><td data-label="Restante">@H(p.Remaining)</td><td data-label="Capacidade total">@H(p.TotalCapacity)</td><td data-label="Saldo futuro">@H(p.FutureBalance)</td></tr>}@if(dashboard.Unassigned is { } unassigned){<tr><th><details><summary>Sem responsável único</summary><TaskList Tasks="unassigned.Tasks" /></details></th><td>—</td><td>—</td><td>—</td><td>—</td><td data-label="Estimativa">@H(unassigned.Original)</td><td data-label="Restante">@H(unassigned.Remaining)</td><td>—</td><td>—</td></tr>}</tbody></table></div></section>
<p class="method-note">Realizado soma apontamentos de quem trabalhou, inclusive antes de uma troca de responsável. Estimativa e restante seguem as implementações atualmente planejadas e seus responsáveis no GitHub. O filtro de produto não divide a capacidade da equipe. Estes indicadores apoiam o planejamento.</p>
}
else if(Navigation.Current==DashboardView.Person)
{
<div class="field context-picker"><label for="dashboard-person">Pessoa</label><select id="dashboard-person" @bind="personId">@foreach(var p in dashboard.People){<option value="@p.Person!.Id">@p.Person.Name</option>}</select></div>
@if(dashboard.People.FirstOrDefault(p=>p.Person!.Id==personId) is { } person){<PersonView Person="person" ReferenceDate="reference" />}
}
else if(Navigation.Current==DashboardView.Features){<FeatureHierarchy Features="@(dashboard.Features??[])" TaskCount="dashboard.Team.TaskCount" Error="@dashboard.HierarchyError" />}
else if(Navigation.Current==DashboardView.Timeline){<FeatureTimelineView Dashboard="@TimelineDashboard()" Today="Today" SelectedPersonId="@timelinePerson" SelectedPersonIdChanged="@(id=>timelinePerson=id)" />}
else if(Navigation.Current==DashboardView.Burndown){<BurndownView @key="refreshKey" ProjectId="local" TeamId="@TeamId.ToString()" Dashboard="dashboard" TimeZoneId="@Zone" />}
else if(Navigation.Current==DashboardView.Export){<TaskExportPanel @key="sprintId" ProjectId="local" TeamId="@TeamId.ToString()" Sprint="dashboard.Sprint" TimeZoneId="@Zone" />}
else if(Navigation.Current==DashboardView.History)
{
<section class="planning-section"><h2>Alterações de esforço e planejamento</h2><p>Histórico registrado no TimeOps, com autoria e valores anteriores.</p><div class="table-scroll compact-table"><table><thead><tr><th>Data / pessoa</th><th>Implementação</th><th>Alteração</th><th>Antes</th><th>Depois</th></tr></thead><tbody>@foreach(var e in Data.Events.Where(e=>e.FromSprintId==sprintId||e.ToSprintId==sprintId).OrderByDescending(e=>e.At).ThenByDescending(e=>e.Id)){var i=Data.Implementations.Single(i=>i.Id==e.ImplementationId);<tr><th>@TimeZoneInfo.ConvertTime(e.At,TimeZoneInfo.FindSystemTimeZoneById(Zone)).ToString("dd/MM/yyyy HH:mm")<small>@UserName(e.ActorId)</small></th><td>@Data.Tasks.Single(t=>t.Id==i.TaskId).Title<small>@Data.Products.Single(p=>p.Id==i.ProductId).Name</small></td><td>@EventLabel(e)</td><td>@(e.Kind=="scope"?SprintName(e.FromSprintId):H(e.Before))</td><td>@(e.Kind=="scope"?SprintName(e.ToSprintId):H(e.After))</td></tr>}</tbody></table></div></section>
}
}
}
</SectionTabs>
@code{
private static readonly TabItem[] ReportTabs = [new("Team", "Equipe"), new("Person", "Por pessoa"), new("Features", "Por tarefa"), new("Timeline", "Timeline"), new("History", "Histórico"), new("Burndown", "Burndown"), new("Export", "Exportar Excel")];
private void SelectReport(string value) => Navigation.Select(Enum.Parse<DashboardView>(value));
private int cycleId,sprintId,productId,refreshKey,reportGeneration;private DateOnly reference=DateOnly.FromDateTime(DateTime.UtcNow).AddDays(-1);private string personId="";private string? timelinePerson;private Dashboard? dashboard;
private string Zone=>Data.Teams.SingleOrDefault(t=>t.Id==TeamId)?.TimeZoneId??"America/Sao_Paulo";
private DateOnly Today=>DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(),TimeZoneInfo.FindSystemTimeZoneById(Zone)).DateTime);
private IEnumerable<PlanningSprint> Sprints=>Data.Sprints.Where(s=>s.TeamId==TeamId&&(cycleId==0||s.CycleId==cycleId)).OrderByDescending(s=>s.Start);
private string ViewTitle=>Navigation.Current switch{DashboardView.Person=>"Acompanhamento por pessoa",DashboardView.Features=>"Horas por tarefa",DashboardView.Timeline=>"Timeline das tarefas",DashboardView.History=>"Histórico",DashboardView.Burndown=>"Burndown da sprint",DashboardView.Export=>"Exportar horas",_=>"Painel da equipe"};
protected override void OnInitialized()=>Navigation.Changed+=Changed;
protected override async Task OnContextLoadedAsync(){cycleId=0;productId=0;reference=Today.AddDays(-1);SelectSprint();await LoadDashboard();}
private void Changed()=>_=InvokeAsync(StateHasChanged);
public void Dispose()=>Navigation.Changed-=Changed;
private void SelectSprint(){var current=Sprints.Where(s=>s.Start<=Today&&s.End>=Today).ToArray();sprintId=current.Length==1?current[0].Id:Sprints.FirstOrDefault()?.Id??0;}
private Task ChangeTeam(ChangeEventArgs e)=>TeamChanged(e);
private async Task CycleChanged(){SelectSprint();await LoadDashboard();}
private async Task LoadDashboard()
{
    var generation=++reportGeneration;
    var team=TeamId;var sprint=sprintId;
    dashboard=null;
    if(sprint==0||team==0||Workspace is null)return;
    var result=await Reports.DashboardAsync(team,sprint,reference,productId==0?null:productId);
    if(generation!=reportGeneration||TeamId!=team||Workspace is null)return;
    var selectedTeam=Data.Teams.SingleOrDefault(t=>t.Id==team);
    if(selectedTeam is null)return;
    if(result.IsFailure)Error=result.Error!.Message;
    else{dashboard=result.Value;Error=null;if(!dashboard.People.Any(p=>p.Person!.Id==personId))personId=dashboard.People.FirstOrDefault()?.Person?.Id??"";Navigation.SetContext("GitHub Projects",selectedTeam.Name,dashboard.Sprint.Name);}
}
private async Task Refresh(){await Reload();await LoadDashboard();refreshKey++;}
private string SprintName(int? id)=>id is null?"Backlog":Data.Sprints.SingleOrDefault(s=>s.Id==id)?.Name??"Sprint indisponível";
private static string EventLabel(PlanningEvent e)=>e.Kind switch{"remaining"=>"Trabalho restante","original"=>"Estimativa","completed"=>"Apontamento de horas","scope"=>"Replanejamento",_=>e.Kind};
private Dashboard TimelineDashboard(){var groups=Data.Tasks.Where(t=>t.TeamId==TeamId).Select(t=>{var implementations=Data.Implementations.Where(i=>i.TaskId==t.Id&&(productId==0||i.ProductId==productId)).ToArray();var periods=implementations.Where(i=>i.SprintId is not null).Select(i=>Data.Sprints.Single(s=>s.Id==i.SprintId)).ToArray();var parent=new ParentWorkItem(t.Id,t.Title,"Feature",null,$"/tarefas?team={TeamId}",periods.Length==0?null:periods.Min(s=>s.Start),periods.Length==0?null:periods.Max(s=>s.End));var work=implementations.Select(i=>{var ids=JsonSerializer.Deserialize<string[]>(i.AssigneeIdsJson)!;return new TaskWork(i.Id,Data.Products.Single(p=>p.Id==i.ProductId).Name,ids.Length==1?new Person(ids[0],UserName(ids[0])):null,i.StatusName,i.StateCategory,"","",0,i.Original,i.Remaining,i.IssueUrl??"/tarefas",t.Id);}).ToArray();return new FeatureEffort(parent,[new StoryEffort(null,work,0)],0);}).Where(g=>g.Stories.Any(s=>s.Tasks.Count>0)).ToArray();return dashboard! with{Features=groups};}
}
