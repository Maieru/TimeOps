# Copie para .env e preencha antes de executar. Nunca envie .env ou a chave ao Git.
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password
TIMEOPS_PORT=5191
ASPNETCORE_ENVIRONMENT=Development
# IP do proxy reverso visto pelo container, para uma instalação com HTTPS.
TIMEOPS_TRUSTED_PROXY_IP=127.0.0.1
GITHUB_ORGANIZATION=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_BOOTSTRAP_ADMIN_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_FILE=.secrets/github.pem
